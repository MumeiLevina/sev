# ------------------------------------------------------------------
# SUBTITLE SERVICE — ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and fill in your secrets.
# ------------------------------------------------------------------

# ── Server ──
API_PORT=8000
HTTP_PORT=8090

# ── PostgreSQL ──
POSTGRES_USER=kinetic
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=subtitle_service
DATABASE_URL=postgresql://kinetic:CHANGE_ME@postgres:5432/subtitle_service

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── JWT Authentication ──
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_256_BIT_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OpenAI ──
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Google OAuth2 (optional, leave empty to disable) ──
GOOGLE_CLIENT_ID=

# ── S3 / MinIO ──
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=subtitle-uploads
S3_SECURE=false

# ── Upload Limits ──
MAX_UPLOAD_SIZE_MB=100

# ── Quota (seconds of audio per plan) ──
FREE_QUOTA_SECONDS=3600
PRO_QUOTA_SECONDS=36000
PREMIUM_QUOTA_SECONDS=0

# ── MinIO Console ──
MINIO_CONSOLE_PORT=9002
