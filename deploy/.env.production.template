# ═══════════════════════════════════════════════════════════════
# KINETIC TECH — PRODUCTION ENVIRONMENT TEMPLATE
# ═══════════════════════════════════════════════════════════════
# Copy this file and fill in real values before deploying:
#   cp .env.production.template .env.production
#
# ⚠️  NEVER commit .env.production to version control!
# ═══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────
# DOMAIN & NETWORKING
# ──────────────────────────────────────────────────────────────
DOMAIN=studenttools.vn
PDF_API_DOMAIN=pdf-api.studenttools.vn
SUB_API_DOMAIN=sub-api.studenttools.vn

# ──────────────────────────────────────────────────────────────
# PDF CONVERTER SERVICE
# ──────────────────────────────────────────────────────────────
PDF_HTTP_PORT=8080
PDF_S3_ACCESS_KEY=CHANGE_ME_pdf_minio_access_key
PDF_S3_SECRET_KEY=CHANGE_ME_pdf_minio_secret_key_min_32_chars
PDF_S3_BUCKET=pdf-conversions
PDF_REDIS_URL=redis://pdf-redis:6379/0
PDF_MAX_UPLOAD_SIZE_MB=50
PDF_WORKER_CONCURRENCY=2
PDF_TEMP_FILE_TTL_MINUTES=60

# ──────────────────────────────────────────────────────────────
# SUBTITLE EXTRACTOR SERVICE
# ──────────────────────────────────────────────────────────────
SUB_HTTP_PORT=8090

# PostgreSQL
SUB_POSTGRES_USER=kinetic_prod
SUB_POSTGRES_PASSWORD=CHANGE_ME_strong_postgres_password_min_32_chars
SUB_POSTGRES_DB=subtitle_service
SUB_DATABASE_URL=postgresql://kinetic_prod:CHANGE_ME_strong_postgres_password_min_32_chars@sub-postgres:5432/subtitle_service

# Redis
SUB_REDIS_URL=redis://sub-redis:6379/0

# JWT Authentication — Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SUB_JWT_SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32
SUB_JWT_ALGORITHM=HS256
SUB_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SUB_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI Whisper API Key
SUB_OPENAI_API_KEY=sk-CHANGE_ME_your_production_openai_key

# Google OAuth2 (optional — leave empty to disable)
SUB_GOOGLE_CLIENT_ID=

# S3 / MinIO
SUB_S3_ACCESS_KEY=CHANGE_ME_sub_minio_access_key
SUB_S3_SECRET_KEY=CHANGE_ME_sub_minio_secret_key_min_32_chars
SUB_S3_BUCKET=subtitle-uploads
SUB_S3_SECURE=false

# Upload & Quota
SUB_MAX_UPLOAD_SIZE_MB=100
SUB_FREE_QUOTA_SECONDS=3600
SUB_PRO_QUOTA_SECONDS=36000
SUB_PREMIUM_QUOTA_SECONDS=0

# ──────────────────────────────────────────────────────────────
# SSL (if using Let's Encrypt on VPS directly)
# ──────────────────────────────────────────────────────────────
LETSENCRYPT_EMAIL=admin@studenttools.vn
