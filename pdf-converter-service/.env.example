# ------------------------------------------------------------------
# CONFIGURATION FOR PDF CONVERSION SYSTEM
# ------------------------------------------------------------------

# Public HTTP Port (Nginx Gateway)
HTTP_PORT=8080

# MinIO Web Console Port
MINIO_CONSOLE_PORT=9001

# S3 / MinIO Credentials
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=pdf-conversions

# Redis Message Queue URL
REDIS_URL=redis://redis:6379/0

# Maximum Allowed File Upload Size in Megabytes
MAX_UPLOAD_SIZE_MB=50

# Worker concurrency per container
WORKER_CONCURRENCY=2

# Temporary File TTL in Minutes (Auto-deletion threshold)
TEMP_FILE_TTL_MINUTES=60
